# ==============================================================================
# Co-work Web Frontend — Environment Variables Template (.env.local.example)
# Instructions: Copy this file to '.env.local' inside apps/web directory.
# ==============================================================================

# Backend API Endpoint URL
NEXT_PUBLIC_API_URL=http://localhost:5000

# Backend Socket.IO WebSocket Server URL
NEXT_PUBLIC_SOCKET_URL=http://localhost:5000

# Optional Google OAuth 2.0 Client ID
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your_google_client_id_here.apps.googleusercontent.com
