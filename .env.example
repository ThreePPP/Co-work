# ==============================================================================
# Co-work — Root Environment Variables Template (.env.example)
# Instructions:
# 1. Copy this file to '.env' in the root directory: cp .env.example .env
# 2. Fill in your own database credentials, JWT secret, and configuration.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Server & Environment Settings
# ------------------------------------------------------------------------------
NODE_ENV=development
PORT=5000

# ------------------------------------------------------------------------------
# 2. PostgreSQL Database Configuration
# Format: postgresql://<USERNAME>:<PASSWORD>@<HOST>:<PORT>/<DATABASE_NAME>?schema=public
# ------------------------------------------------------------------------------
# Example for Local Docker Compose:
# DATABASE_URL=postgresql://cowork_user:cowork_password@localhost:5433/cowork_db?schema=public
DATABASE_URL=postgresql://<DB_USER>:<DB_PASSWORD>@<DB_HOST>:<DB_PORT>/<DB_NAME>?schema=public

# ------------------------------------------------------------------------------
# 3. Security & Authentication (JWT)
# ------------------------------------------------------------------------------
# Secret key used to sign JSON Web Tokens. Generate with: openssl rand -base64 32
JWT_SECRET=your_jwt_secret_key_minimum_32_characters_long
JWT_EXPIRES_IN=7d

# ------------------------------------------------------------------------------
# 4. CORS & Network Origins
# ------------------------------------------------------------------------------
# URL of your frontend application allowed to make requests to the backend
CORS_ORIGIN=http://localhost:3000

# ------------------------------------------------------------------------------
# 5. File Storage Configuration
# ------------------------------------------------------------------------------
# Local directory or mounted path where uploaded documents & media are saved
UPLOAD_DIR=uploads

# ------------------------------------------------------------------------------
# 6. Frontend Client URLs (Next.js Public Variables)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:5000
NEXT_PUBLIC_SOCKET_URL=http://localhost:5000

# ------------------------------------------------------------------------------
# 7. Optional Integrations (OAuth 2.0)
# ------------------------------------------------------------------------------
# Google OAuth 2.0 Client ID from Google Cloud Console
GOOGLE_CLIENT_ID=your_google_client_id_here.apps.googleusercontent.com
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your_google_client_id_here.apps.googleusercontent.com
